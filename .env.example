# PostgreSQL / Supabase Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# JWT Authentication Secret Key
JWT_SECRET="innovative-data-platform-production-secret-key-saif-2026"

# Public Application URL (set to your Vercel deployment domain)
NEXT_PUBLIC_APP_URL="https://admin-website-innovative-data.vercel.app"

# Storage Configuration (local or Supabase S3 bucket)
STORAGE_TYPE="local_cloud_compatible"
